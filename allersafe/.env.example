# Turso (libSQL) database
# Get these from https://turso.tech after running: turso db create allersafe
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Resend email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# iron-session secret (must be >= 32 chars — generate with: openssl rand -base64 32)
IRON_SESSION_PASSWORD=replace-this-with-a-long-random-secret-string-32-chars-min
