# ── Supabase (PostgreSQL) ───────────────────────────────────────────────────
# Used server-side only. RLS is disabled; authorization is enforced by
# iron-session in the API routes, so this key must NOT be exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Resend email (https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── iron-session secret (>= 32 chars — generate with: openssl rand -base64 32)
IRON_SESSION_PASSWORD=replace-this-with-a-long-random-secret-string-32-chars-min

# ── Stripe billing (https://dashboard.stripe.com) ───────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring Price IDs (create Products in Stripe, then copy the Price IDs)
STRIPE_PRICE_SINGLE=price_xxx   # Single site — £15/mo, 1 venue
STRIPE_PRICE_MULTI=price_xxx    # Multi-site — £29/mo, up to 5 venues
# One-off Price ID for the "we'll import your menu" setup add-on (£49)
STRIPE_PRICE_SETUP=price_xxx

# ── App URL (used for Stripe checkout redirects) ────────────────────────────
# Optional — falls back to the request origin if unset. Set in production.
NEXT_PUBLIC_APP_URL=https://allersafe.vercel.app
