# =============================================================================
# GetPaid — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ---- REQUIRED ----------------------------------------------------------------

# Session secret — generate with: openssl rand -base64 32
# Must be at least 32 characters.
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

# ---- RECOMMENDED (auth email) ------------------------------------------------

# Resend API key — get one at resend.com (free tier is fine for solo use)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "From" address for emails (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourapp.com

# ---- OPTIONAL: Turso cloud sync (Business plan) ------------------------------

# Get these from turso.tech after creating a database
# If NOT set, the app uses localStorage (browser only — no server persistence)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ---- OPTIONAL: Vercel Cron security -----------------------------------------

# If set, the /api/reminders cron endpoint checks for this secret.
# Vercel adds x-vercel-cron: 1 automatically; this is an extra safeguard.
CRON_SECRET=your-cron-secret

# ---- OPTIONAL: Company defaults for cron reminders --------------------------

COMPANY_NAME="Your Company Ltd"
COMPANY_ADDRESS="Your Address, City, Postcode"
COMPANY_CONTACT="Your Name"
COMPANY_EMAIL="you@yourcompany.co.uk"

# ---- OPTIONAL: Future AI tailoring ------------------------------------------

# Stub is at /api/ai — set this when ready to enable Claude-powered letters.
# ANTHROPIC_API_KEY=sk-ant-...
